{
  "configurations": [
    {
      "cStandard": "c11",
      "compilerPath": "arm-none-eabi-g++.exe",
      "cppStandard": "c++14",
      "compilerArgs": ["-mcpu=cortex-m7", "-mthumb", "-mfpu=fpv5-d16", "-mfloat-abi=hard", "-include", "stm32h7xx.h"],
      "defines": [
        "USE_HAL_DRIVER",
        "STM32H750xx",
        "STM32H750IB",
        "CORE_CM7",
        "ARM_MATH_CM7",
        "USE_FULL_LL_DRIVER",
        "USE_ARM_DSP",
        "BOOT_APP",
        "MESA_POWER_ENABLE=0",
        "MESA_POWER_PRESENCE_PIN=-1",
        "MESA_POWER_POST_IR_PRESENCE=0",
        "MESA_POWER_PICK_ATTACK_PIN=-1",
        "ENABLE_OUTPUT_STAGE_PIN=16",
        "DELAY_ENABLE_PIN=13",
        "DELAY_LEVEL_PIN=17",
        "DELAY_TIME_PIN=18",
        "DELAY_FEEDBACK_PIN=19",
        "REVERB_ENABLE_PIN=14",
        "REVERB_LEVEL_PIN=15",
        "IR_SELECTOR_PIN=12"
      ],
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/libDaisy/**",
        "${workspaceFolder}/DaisySP/Source/**"
      ],
      "name": "Win32",
      "windowsSdkVersion": "10.0.17763.0"
    },
